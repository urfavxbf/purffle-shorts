# Bakit Nga Ba? — public, nonsecret channel configuration.
# This file is checked into git; NEVER add API keys or YouTube credentials here.
# Explicit export-only policy; the dedicated workflow also passes --no-upload.
UPLOAD=false
KEEP_VIDEOS=true
PUBLISH_TO=youtube
YT_PRIVACY=private
MADE_FOR_KIDS=false
SYNTHETIC_MEDIA=true

CHANNEL_NAME=Bakit Nga Ba?
AUDIENCE=Filipino adults interested in relationships and interesting facts
NICHES=relationship psychology,interesting facts,Filipino explainers
TOPIC_SOURCES=niche
LANGUAGE=fil
SCRIPT_STYLE=explainer
SCRIPT_REVIEW=off
TARGET_SECONDS=55
TIMEZONE=Asia/Manila

TTS_ENGINE=edge
TTS_VOICE=fil-PH-AngeloNeural
TTS_RATE=-8%
ALIGN=auto

# An image-to-video look: 3D-style AI stills + Ken Burns/parallax, NOT true rigged 3D animation.
# Pollinations anonymous image creation may be rate-limited, unavailable or require credits.
# The renderer can fall back to procedural backgrounds; review visuals before publishing.
VISUAL_SOURCES=pollinations
# Fail closed if even ONE scene lacks genuine imagery. Never silently output gradients.
MIN_VISUAL_COVERAGE=1.0
VISUAL_STYLE=fully computer generated stylized 3D animated feature film frame, expressive sculpted faces, rounded character designs, coherent Maya and Nico models, dramatic cinematic lighting, rich detail, NOT a photograph, no text
ASPECT=9:16
RESOLUTION=1080x1920
FPS=30
CAPTION_STYLE=bold
CAPTION_POSITION=center
CAPTION_MAX_WORDS=3
CAPTION_UPPERCASE=false
CAPTION_EMPHASIS=true
CAPTION_EMOJI=false
COLOR_GRADE=cinematic
TRANSITION=fade
MAX_SHOT_SECONDS=4.5
KEN_BURNS=true
PROGRESS_BAR=true
HOOK_OVERLAY=true
WATERMARK=Bakit Nga Ba?
END_CTA=Ano sa tingin mo? I-comment mo!
MUSIC_VOLUME=0.12
MUSIC_DUCKING=true
SOUND_EFFECTS=true
SFX_VOLUME=0.6

OUTPUT_DIR=output_videos
DATA_DIR=data
